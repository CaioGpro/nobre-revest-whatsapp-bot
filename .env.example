# Supabase (projeto "nobre-revest-crm")
SUPABASE_URL=https://uhnwabudxvxialmjxwmd.supabase.co
# Use a SERVICE ROLE key aqui (não a publishable/anon) — pegue em
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Gemini (Google), usada para gerar as respostas da IA
# Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo do Gemini a ser usado para responder os clientes
GEMINI_MODEL=gemini-3.8-flash

# Se true, a IA responde automaticamente. Se false, apenas grava a
# sugestão de resposta no banco (coluna sender='ia') sem enviar.
AUTO_RESPOND=true

# Se true, o bot só atende a conversa do Caio com o próprio número (para
# testar sem outro celular); clientes de verdade só têm a mensagem gravada.
# O comando `npm run teste` já liga isso.
MODO_TESTE=false
