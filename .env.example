# Supabase (projeto "nobre-revest-crm")
SUPABASE_URL=https://uhnwabudxvxialmjxwmd.supabase.co
# Use a SERVICE ROLE key aqui (não a publishable/anon) — pegue em
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic (Claude), usada para gerar as respostas da IA
# Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo do Claude a ser usado para responder os clientes
CLAUDE_MODEL=claude-sonnet-5

# Se true, a IA responde automaticamente. Se false, apenas grava a
# sugestão de resposta no banco (coluna sender='ia') sem enviar.
AUTO_RESPOND=true
